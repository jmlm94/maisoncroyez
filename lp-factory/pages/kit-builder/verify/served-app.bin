(function(){var root=document.getElementById("root");if(!root)return;root.innerHTML='<div class="banner">GET A FREE DIFFUSER FOR EVERY SCENT YOU PICK \u2014 TODAY ONLY! <span class="cd" id="cd">23:59:59</span></div>\n<div class="wrap">\n  <div class="side"></div>\n  <div class="panel">\n    <div class="top"><img src="https://cdn.shopify.com/s/files/1/0020/3636/7469/files/mc-kb-logo.png" alt="Maison Croyez"></div>\n    <div class="rating"><span class="stars">\u2605\u2605\u2605\u2605\u2605</span> 2,500+ guests asked \u201Cwhat\u2019s that smell?\u201D so far!</div>\n    <h1>Build your <em>Manifestation Kit.</em></h1>\n    <div class="h1sub">Claim a <b>free diffuser</b> for every scent you pick. Delivers every 30 days. Pause, swap or cancel anytime.</div>\n    <div class="prog"><i id="bar" style="width:33%"></i></div>\n    <div class="pstep"><span id="pnum">1</span> of 3</div>\n\n    <section class="step on" id="s1">\n      <div class="kbgal"><div class="kbg-frame"><div class="kbg-track" id="kbgtrack"><img class="kbg-slide" src="https://cdn.shopify.com/s/files/1/0020/3636/7469/files/mc-kb-hero.jpg?width=820&format=pjpg" alt="Maison Croyez diffuser"><img class="kbg-slide" src="https://cdn.shopify.com/s/files/1/0020/3636/7469/files/Diseno_sin_titulo_92.png?v=1783904283&width=820&format=pjpg" alt="Maison Croyez diffuser and scent" loading="lazy" decoding="async"><img class="kbg-slide" src="https://cdn.shopify.com/s/files/1/0020/3636/7469/files/image-1_1_1.png?v=1773273488&width=820&format=pjpg" alt="Maison Croyez diffuser detail" loading="lazy" decoding="async"><img class="kbg-slide" src="https://cdn.shopify.com/s/files/1/0020/3636/7469/files/image-2_1_1.png?v=1773273488&width=820&format=pjpg" alt="Maison Croyez scent bottle" loading="lazy" decoding="async"><img class="kbg-slide" src="https://cdn.shopify.com/s/files/1/0020/3636/7469/files/image-3_1_1.png?v=1773273488&width=820&format=pjpg" alt="Maison Croyez diffuser in a living room" loading="lazy" decoding="async"><img 